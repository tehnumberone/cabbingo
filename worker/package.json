    "check": "tsc --noEmit && node --experimental-strip-types test.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260916.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.133.0"
  }
